#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__).'/vendor/autoload.php';

use Byd\ApiClient\BydClient;
use Byd\ApiClient\Config\EnvironmentConfigLoader;
use Byd\ApiClient\Exception\BydException;

$command = $argv[1] ?? 'help';
if (!in_array($command, ['help', 'login', 'vehicles'], true)) {
    fwrite(STDERR, "Unknown command: {$command}\n");
    exit(2);
}
if ($command === 'help') {
    echo "BYD API Client\nUsage: byd-api [help|login|vehicles]\nRequired environment: BYD_USERNAME, BYD_PASSWORD\n";
    exit(0);
}

$environment = [];
foreach (['BYD_USERNAME', 'BYD_PASSWORD', 'BYD_CONTROL_PIN', 'BYD_BASE_URL', 'BYD_COUNTRY_CODE', 'BYD_LANGUAGE', 'BYD_TIME_ZONE'] as $name) {
    $environment[$name] = getenv($name);
}

try {
    $client = new BydClient((new EnvironmentConfigLoader())->load($environment));
    if ($command === 'login') {
        $client->authenticate();
        echo "Login successful.\n";
        exit(0);
    }
    foreach ($client->vehicles()->all() as $vehicle) {
        echo "{$vehicle->vin->value}\t{$vehicle->brandName} {$vehicle->modelName}\t{$vehicle->alias}\n";
    }
} catch (BydException|InvalidArgumentException $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(1);
}
