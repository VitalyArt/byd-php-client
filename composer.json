{
  "name": "byd/api-client",
  "description": "PHP client for BYD vehicle API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9",
    "psr/clock": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/log": "^3.0",
    "symfony/serializer": "^7.3|^8.0",
    "symfony/property-access": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Byd\\ApiClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Byd\\ApiClient\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "cs-fix": "@php vendor/bin/php-cs-fixer fix --sequential",
    "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
    "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=512M --no-progress --debug",
    "rector": "@php vendor/bin/rector process --debug",
    "rector-check": "@php vendor/bin/rector process --dry-run --debug",
    "quality": [
      "@test",
      "@phpstan",
      "@cs-check",
      "@rector-check",
      "@composer validate --strict"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
